{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal AI",
  "version": "0.1.0",
  "identifier": "dev.terminal-ai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Terminal AI",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ai-memory"
    ],
    "resources": {
      "resources/third-party/ai-memory-LICENSE.txt": "resources/third-party/ai-memory-LICENSE.txt",
      "binaries/hooks/": "hooks/"
    }
  }
}
